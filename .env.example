# PostgreSQL connection used by apps/api (Prisma)
DATABASE_URL="postgresql://smartpos:smartpos@localhost:5432/smartpos?schema=public"

# JWT secrets - generate strong random values for real use
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API server
API_PORT=4000
# Comma-separated list of allowed frontend origins (add your deployed frontend URL in production)
CORS_ORIGIN="http://localhost:5173"

# Frontend (apps/web) - Vite env vars must be prefixed with VITE_
VITE_API_URL="http://localhost:4000/api/v1"
